{
  "name": "node-printer",
  "version": "0.6.30",
  "description": "Node.js printer bindings",
  "homepage": "https://github.com/liamcmitchell/node-printer",
  "license": "MIT",
  "contributors": [
    "Liam Mitchell <liam.mitchell@siemens.com>",
    "Ion Lupascu <ionlupascu@gmail.com>",
    "Timo Kunze <tkunze@compeso.com",
    "Thiago Lugli <thiagoelg@gmail.com>",
    "Eko Eryanto <ekoeryanto@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/liamcmitchell/node-printer.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "rebuild": "node-gyp rebuild",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write && clang-format -i -style=file src/node_printer.cc src/node_printer_posix.cc src/node_printer_win.cc src/node_printer.hpp src/macros.hh",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "nan": "^2.26.2"
  },
  "devDependencies": {
    "clang-format-node": "^3.0.1",
    "node-abi": "^4.31.0",
    "node-gyp": "^12.3.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 22.0.0"
  }
}
