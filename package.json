{
  "name": "node-printer",
  "version": "1.0.0",
  "description": "Node.js printer bindings",
  "homepage": "https://github.com/liamcmitchell/node-printer",
  "license": "MIT",
  "contributors": [
    "Liam Mitchell <liam.mitchell@siemens.com>",
    "Ion Lupascu <ionlupascu@gmail.com>",
    "Timo Kunze <tkunze@compeso.com",
    "Thiago Lugli <thiagoelg@gmail.com>",
    "Eko Eryanto <ekoeryanto@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/liamcmitchell/node-printer.git"
  },
  "files": [
    "lib/",
    "src/",
    "binding.gyp"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "rebuild": "node-gyp rebuild",
    "test": "node --test test/printer.test.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write && clang-format -i -style=file src/linux_gcc_compat.h src/node_printer.cc src/node_printer_posix.cc src/node_printer_win.cc src/node_printer.hpp src/printer_model.cc src/printer_model.hpp",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "node-addon-api": "^8.2.2"
  },
  "devDependencies": {
    "clang-format-node": "^3.0.1",
    "node-abi": "^4.31.0",
    "node-gyp": "^12.3.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.59.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "packageManager": "npm@12.0.1+sha512.2f94fd8bf600416416a934bfc59c4991e8bff7372ef7d842784e2a8b8d48c81555ee645069ddea73625fb8e92dc261feab0188fd5dab6c22fefd46316f5f9140"
}
